                      "type": "integer"
                    },
                    "max_strokes_bytes": {
                      "type": "integer"
                    },
                    "max_upload_bytes": {
                      "type": "integer"
                    },
                    "min_edge_px": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
