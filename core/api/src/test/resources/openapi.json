    "/app/v1/sketch/conversations/{conversation_id}/events": {
      "get": {
        "operationId": "poll_events_app_v1_sketch_conversations__conversation_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 30,
              "minimum": 0,
              "title": "Wait",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "cursor": {
                      "type": "integer"
                    },
                    "events": {
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "events after the cursor (long poll with wait)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "missing, unknown, revoked or other-plugin bearer token (unauthorized)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "no such conversation, attachment or device (not_found, no_spec, unknown_session)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "invalid request (invalid_request, idempotency_mismatch, preset_not_allowed)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "per-device rate limit; see Retry-After (rate_limited)"
          }
        },
        "security": [
          {
            "deviceToken": []
          }
        ],
        "summary": "Poll events after a cursor"
      }
    },
