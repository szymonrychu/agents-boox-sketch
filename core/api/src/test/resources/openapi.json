{
  "components": {
    "schemas": {
      "DeviceOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plugin": {
            "title": "Plugin",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "required": [
          "device_id",
          "name",
          "plugin",
          "created_at",
          "revoked_at"
        ],
        "title": "DeviceOut",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Event": {
        "additionalProperties": true,
        "description": "type is sketch_status, spec, message or handoff; the remaining fields depend on the type (sketch_id or message_id or handoff_id, status, reason, session_slug).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "cursor": {
            "type": "integer"
          },
          "type": {
            "enum": [
              "sketch_status",
              "spec",
              "message",
              "handoff"
            ],
            "type": "string"
          }
        },
        "required": [
          "cursor",
          "type",
          "created_at"
        ],
        "title": "Event",
        "type": "object"
      },
      "HandoffIn": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "format": "uuid",
            "title": "Client Id",
            "type": "string"
          },
          "session": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/PresetTarget"
              }
            ],
            "title": "Session"
          }
        },
        "required": [
          "client_id",
          "session"
        ],
        "title": "HandoffIn",
        "type": "object"
      },
      "MessageIn": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "format": "uuid",
            "title": "Client Id",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "text"
        ],
        "title": "MessageIn",
        "type": "object"
      },
      "PairRequest": {
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "plugin": {
            "default": "sketch",
            "title": "Plugin",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "PairRequest",
        "type": "object"
      },
      "PairResponse": {
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "plugin": {
            "title": "Plugin",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "name",
          "plugin",
          "token"
        ],
        "title": "PairResponse",
        "type": "object"
      },
      "PresetTarget": {
        "additionalProperties": false,
        "properties": {
          "preset": {
            "minLength": 1,
            "title": "Preset",
            "type": "string"
          }
        },
        "required": [
          "preset"
        ],
        "title": "PresetTarget",
        "type": "object"
      },
      "SketchUpload": {
        "properties": {
          "meta": {
            "description": "JSON: {\"client_id\": uuid, \"conversation\": \"current\"|\"new\", \"conversation_id\"?: uuid, \"caption\"?: string, \"pages\": [{\"page\": int, \"canvas\": {\"w\", \"h\", \"dpi\"}}]}. Part i (sketch.<i>.png, strokes.<i>.json) belongs to pages[i]; every page needs its png.",
            "type": "string"
          },
          "sketch.0.png": {
            "format": "binary",
            "type": "string"
          },
          "strokes.0.json": {
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "meta",
          "sketch.0.png"
        ],
        "title": "SketchUpload",
        "type": "object"
      },
      "Spec": {
        "properties": {
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "sketch_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "version",
          "markdown",
          "created",
          "sketch_ids"
        ],
        "title": "Spec",
        "type": "object"
      }
    },
    "securitySchemes": {
      "deviceToken": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Device API under /app/v1/sketch (public, bearer device token) and admin API under /app/admin/v1 (behind SSO and a source CIDR allowlist).",
    "title": "agents-app-connector",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/app/admin/v1/devices": {
      "get": {
        "operationId": "list_devices_app_admin_v1_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceOut"
                  },
                  "title": "Response List Devices App Admin V1 Devices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "source address is not allowed (forbidden)"
          }
        },
        "summary": "Pair or list devices"
      },
      "post": {
        "operationId": "pair_app_admin_v1_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "source address is not allowed (forbidden)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "invalid request (invalid_request, idempotency_mismatch, preset_not_allowed)"
          }
        },
        "summary": "Pair or list devices"
      }
    },
    "/app/admin/v1/devices/{device_id}": {
      "delete": {
        "operationId": "revoke_app_admin_v1_devices__device_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "source address is not allowed (forbidden)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "no such conversation, attachment or device (not_found, no_spec, unknown_session)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "invalid request (invalid_request, idempotency_mismatch, preset_not_allowed)"
          }
        },
        "summary": "Revoke a device"
      }
    },
    "/app/v1/sketch/attachments/{attachment_id}": {
      "get": {
        "operationId": "get_attachment_app_v1_sketch_attachments__attachment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "attachment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Attachment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "the stored file with an ETag; 304 on a matching If-None-Match"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "missing, unknown, revoked or other-plugin bearer token (unauthorized)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "no such conversation, attachment or device (not_found, no_spec, unknown_session)"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "the attachment was purged (purged)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "per-device rate limit; see Retry-After (rate_limited)"
          }
        },
        "security": [
          {
            "deviceToken": []
          }
        ],
        "summary": "Download a stored sketch file"
      }
    },
    "/app/v1/sketch/config": {
      "get": {
        "operationId": "config_app_v1_sketch_config_get",
